# Веб-сервер фронтенда в Coolify (Nixpacks ставит Caddy 2.8 для Vite-SPA).
# Запускается из nixpacks.toml; если Caddy в образе нет, там же откат на
# `vite preview`, как было раньше.
#
# Отличия от раздачи «index.html на любой адрес»:
#   - код 200 только у маршрутов приложения (src/App.jsx), остальное — та же
#     страница приложения, но с кодом 404 (покажется «Страница не найдена»):
#     поисковики больше не видят копию сайта под мусорными адресами;
#   - публичные страницы получают копию index.html со своими title,
#     description и canonical (scripts/prerender-seo.mjs), язык — из ?lang=;
#   - заголовки безопасности, которых фронтенд раньше не отправлял.

{
	admin off
	persist_config off
	auto_https off # HTTPS терминирует прокси Coolify
	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:1342} {
	root * {$NIXPACKS_SPA_OUTPUT_DIR:dist}
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(self), microphone=(self), display-capture=(self), fullscreen=(self), geolocation=(), payment=(), usb=()"
	}

	# Хэшированные ассеты сборки неизменны — кэшируем надолго; index.html — нет.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@html path / *.html
	header @html Cache-Control "no-cache"

	handle /health {
		respond 200
	}

	map {query.lang} {seo_lang} {
		ru ru
		kk kk
		default en
	}

	# Копии страниц доступны только по адресам самих страниц.
	handle /seo/* {
		error 404
	}

	handle / {
		try_files /seo/{seo_lang}/index.html /index.html
		file_server
	}

	# Маршруты приложения из src/App.jsx. Добавили страницу — добавьте её сюда,
	# иначе сервер ответит на неё 404.
	@app path_regexp ^/((about|blog|doctors|specializations|prices|tourism|privacy|terms|login|register|forgot-password|reset-password|verify-email-sent|email-confirmed|patient|doctor|admin|manager|coordinator)(/.*)?|(treatments|consultation)/.+|payment/(success|failure))/?$
	handle @app {
		try_files /seo/{seo_lang}{path}/index.html {path}/index.html /index.html
		file_server
	}

	# Файлы сборки и public/: ассеты, robots.txt, sitemap.xml, картинки.
	handle {
		file_server
	}

	handle_errors {
		@notFound expression {err.status_code} == 404
		handle @notFound {
			rewrite * /index.html
			file_server
		}
	}
}
